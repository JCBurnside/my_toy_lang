let sum3 (a:int32) (b:int32) (c:int32) = a + b + c;
// should have a suggestion for point free.
let sum2and3 b c = sum3 3 b c;

let sum2and3_pointfree = sum3 3;

let sum1and3and4 = sum2and3_pointfree 4;

for<T,E> enum Result = | Ok T | Err E

for<T> enum Maybe = | None | Some T
for<T> type TestStruct = {
    a : T
}
let use_enum (a:Result<int32,()>) (b:Maybe<int32>) = match a where
    | Result::Ok v -> v,
    | Result::Err () -> match b where
        | Maybe::None -> 0,
        | Maybe::Some v -> v,

let use_struct (a:TestStruct<int32>) = ();
let main () =
    let foo = "a\n";
    return ();
